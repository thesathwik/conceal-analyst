ENV=dev                                   # dev | rocm
# dev: hosted open-weight provider (OpenAI-compatible)
ASR_BASE_URL=https://<provider>/openai/v1
ASR_API_KEY=
ASR_MODEL=whisper-large-v3
LLM_BASE_URL=https://<provider>/v1
LLM_API_KEY=
LLM_MODEL=<provider's Qwen 7B/8B instruct ID>
# rocm: our vLLM on MI300X (uncomment on Day 2)
# ASR_BASE_URL=http://<gpu-host>:8001/v1
# LLM_BASE_URL=http://<gpu-host>:8000/v1
# ASR_API_KEY=EMPTY
# LLM_API_KEY=EMPTY
# ASR_MODEL=openai/whisper-large-v3
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
CHUNK_SECONDS=10
WINDOW_SECONDS=150
PLAYBACK_SPEED=1

# --- optional (defaults shown) ---
# CHUNK_OVERLAP_SECONDS=0                 # audio overlap between chunks; duplicate words are de-duped
# CUT_RAISE_RELATIVE_PCT=5                # CUT/RAISE threshold, relative change of midpoint
# MARGIN_THRESHOLD_BPS=50                 # CUT/RAISE threshold for margins
# LLM_JSON_MODE=true                      # send response_format=json_object
# ASR_PRECISION=fp16                      # labels recorded in validation/bench output
# LLM_PRECISION=fp16                      # set to fp8 when vLLM runs --quantization fp8
# Recorded with every run on the GPU box (see deploy/README.md):
# GPU_MODEL= ROCM_VERSION= IMAGE_TAG= VLLM_VERSION= VLLM_FLAGS= ASR_BACKEND=vllm
