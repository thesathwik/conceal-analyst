# docker compose --env-file for deploy/docker-compose.rocm.yml (lives on the GPU box)
MODEL_CACHE=/data/models
# needed for gated models (Llama 3.1)
HF_TOKEN=

# --- LLM (port 8000) ---
LLM_MODEL_ID=Qwen/Qwen2.5-7B-Instruct      # or mistralai/Mistral-7B-Instruct-v0.3, meta-llama/Llama-3.1-8B-Instruct
LLM_GPU=0
LLM_DTYPE=bfloat16
LLM_MAX_MODEL_LEN=8192
LLM_GPU_MEM=0.45                           # LLM + ASR share one MI300X (192 GB); split memory
LLM_MAX_NUM_SEQS=64
LLM_MAX_NUM_BATCHED_TOKENS=8192
# FP8: --quantization fp8 --kv-cache-dtype fp8
#   chunked prefill off: --no-enable-chunked-prefill
#   benchmarks: --no-enable-prefix-caching (identical replayed calls would hit the cache)
LLM_EXTRA_ARGS=

# --- ASR (port 8001) ---
ASR_MODEL_ID=openai/whisper-large-v3        # or openai/whisper-large-v3-turbo, distil-whisper/distil-large-v3
ASR_GPU=0
ASR_DTYPE=float16
ASR_GPU_MEM=0.20
ASR_MAX_NUM_SEQS=32
# older vLLM may need: --task transcription
ASR_EXTRA_ARGS=

PYTORCH_TUNABLEOP_ENABLED=0                # sweep: 1
